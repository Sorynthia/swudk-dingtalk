# 只有 true 时开放二维码登录、住宿查询和临时签到；其他值均视为关闭。
SERVICE_ENABLED=false

# 必须与浏览器实际访问的来源完全一致，且末尾不带斜杠；生产环境必须使用 HTTPS。
APP_ORIGIN=https://example.com

# 仅当应用位于会覆盖 X-Forwarded-For / X-Forwarded-Proto 的可信反向代理后时设为 true。
TRUST_PROXY=false

# pnpm dev 和 pnpm start 使用的监听端口。
PORT=3001

# 必填。请使用 `openssl rand -base64 32` 生成，不要提交真实值。
SESSION_SECRET=
